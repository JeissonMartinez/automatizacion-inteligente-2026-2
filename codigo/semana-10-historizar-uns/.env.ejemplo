# Copie este archivo como .env y cambie TODOS los valores CAMBIE_...
#   cp .env.ejemplo .env && nano .env
# El .env nunca se sube al repositorio.

# --- InfluxDB: usuario de la interfaz web (clave de mínimo 8 caracteres) ---
INFLUX_USUARIO=admin
INFLUX_CLAVE=CAMBIE_ESTA_CLAVE
INFLUX_ORG=unipamplona
INFLUX_BUCKET=uns
# Token de administración. Genere uno con:  openssl rand -hex 32
INFLUX_TOKEN=CAMBIE_ESTE_TOKEN

# --- Telegraf: usuario MQTT creado con mosquitto_passwd (paso 4) ---------
MQTT_USUARIO_TELEGRAF=telegraf
MQTT_CLAVE_TELEGRAF=CAMBIE_ESTA_CLAVE

# --- Grafana: usuario de la interfaz web ----------------------------------
GRAFANA_USUARIO=admin
GRAFANA_CLAVE=CAMBIE_ESTA_CLAVE

# --- Simulador (opcional): jerarquía acordada, sin dispositivo ni barra final
RUTA_SIMULADOR=empresa/sitio/area/linea/celda
