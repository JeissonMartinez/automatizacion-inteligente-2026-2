    {
        "id": "orden_do",
        "type": "function",
        "z": "tab_uns",
        "name": "Orden salida discreta",
        "func": "// Publica la orden en cmd. Si en 3 s no llega la confirmación del ESP32,\n// el interruptor vuelve al último valor confirmado.\nconst base = flow.get(\"base\"), V = flow.get(\"V\"), C = flow.get(\"C\");\nconst pedido = msg.payload === true;\nnode.send([{ topic: base + \"/\" + C.cmd + \"/\" + V.do, payload: pedido ? \"1\" : \"0\", qos: 1, retain: false }, null]);\nsetTimeout(() => {\n    const conf = flow.get(\"do_confirmado\");\n    if (conf !== pedido) node.send([null, { payload: conf === true }]);\n}, 3000);\nreturn null;\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1290,
        "y": 280,
        "wires": [
            [
                "mqtt_out"
            ],
            [
                "sw_do"
            ]
        ],
        "info": ""
