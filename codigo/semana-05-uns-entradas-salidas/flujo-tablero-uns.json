    {
        "id": "configuracion",
        "type": "function",
        "z": "tab_uns",
        "name": "Configuración",
        "func": "// =====================================================================\n// ÚNICO NODO QUE DEBE EDITAR\n// Escriba la misma RUTA y el mismo DISPOSITIVO del programa del ESP32.\n// =====================================================================\nconst RUTA        = \"empresa/sitio/area/linea/celda\";\nconst DISPOSITIVO = \"esp32-01\";\n\n// Nombres de las variables (iguales a VAR_DI, VAR_AI, VAR_DO y VAR_AO)\nconst V = { di: \"pulsador\", ai: \"potenciometro\", do: \"led\", ao: \"brillo\" };\n\n// Nombres de las clases de dato (iguales a los del programa del ESP32)\nconst C = { med: \"medicion\", sal: \"salida\", cmd: \"cmd\", est: \"estado\" };\n\n// ---------------------------------------------------------------------\nconst base = RUTA + \"/\" + DISPOSITIVO;\nflow.set(\"base\", base);\nflow.set(\"V\", V);\nflow.set(\"C\", C);\nnode.status({ fill: \"blue\", shape: \"dot\", text: base });\n\n// Se suscribe a todo lo que cuelga del dispositivo\nreturn { action: \"subscribe\", topic: { topic: base + \"/#\", qos: 1 } };\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 100,
        "wires": [
            [
                "mqtt_in"
            ]
        ],
        "info": ""
    },
    {
        "id": "mqtt_in",
        "type": "mqtt in",
        "z": "tab_uns",
        "name": "UNS (suscripción dinámica)",
        "topic": "",
        "qos": "1",
        "datatype": "auto-detect",
        "broker": "broker_uns",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 1,
        "x": 590,
        "y": 100,
        "wires": [
            [
                "clasificar"
            ]
        ]
    },
    {
        "id": "clasificar",
        "type": "function",
        "z": "tab_uns",
        "name": "Clasificar",
        "func": "// Reparte cada mensaje del dispositivo al elemento del tablero que le corresponde.\nconst base = flow.get(\"base\");\nconst V = flow.get(\"V\");\nconst C = flow.get(\"C\");\nif (!base || !msg.topic.startsWith(base + \"/\")) return null;\n\nconst rel = msg.topic.substring(base.length + 1);\nlet p = msg.payload;\nlet valor = (p !== null && typeof p === \"object\" && \"valor\" in p) ? p.valor : p;\nif (typeof valor === \"string\" && valor.trim() !== \"\" && !isNaN(valor)) valor = Number(valor);\n\nswitch (rel) {\n    case C.med + \"/\" + V.di:\n        return [{ payload: valor == 1 ? \"ACTIVA (1)\" : \"inactiva (0)\" }, null, null, null, null];\n    case C.med + \"/\" + V.ai:\n        return [null, { payload: valor, topic: V.ai }, null, null, null];\n    case C.sal + \"/\" + V.do:\n        flow.set(\"do_confirmado\", valor == 1);\n        return [null, null, { payload: valor == 1 }, null, null];\n    case C.sal + \"/\" + V.ao:\n        flow.set(\"ao_confirmado\", valor);\n        return [null, null, null, { payload: valor }, null];\n    case C.est:\n        return [null, null, null, null, { payload: String(p) }];\n}\nreturn null;\n",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 100,
        "wires": [
            [
                "txt_di"
            ],
            [
                "graf_ai",
                "aguja_ai"
            ],
            [
                "sw_do"
            ],
            [
                "sl_ao"
            ],
            [
                "fn_estado"
            ]
        ],
        "info": ""
    },
