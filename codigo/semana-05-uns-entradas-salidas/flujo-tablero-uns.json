    {
        "id": "orden_ao",
        "type": "function",
        "z": "tab_uns",
        "name": "Orden salida continua",
        "func": "// Publica la orden en cmd. Si en 3 s no llega la confirmación del ESP32,\n// el deslizador vuelve al último valor confirmado.\nconst base = flow.get(\"base\"), V = flow.get(\"V\"), C = flow.get(\"C\");\nconst pedido = Math.round(Number(msg.payload));\nnode.send([{ topic: base + \"/\" + C.cmd + \"/\" + V.ao, payload: String(pedido), qos: 1, retain: false }, null]);\nsetTimeout(() => {\n    const conf = flow.get(\"ao_confirmado\");\n    if (conf !== undefined && conf !== pedido) node.send([null, { payload: conf }]);\n}, 3000);\nreturn null;\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
